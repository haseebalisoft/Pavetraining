# Auth.js / NextAuth (Microsoft Entra ID login)
AUTH_SECRET=generate-a-long-random-string
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-app-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-app-client-secret
# Use your tenant GUID in production, or "common" for multi-tenant / local bootstrap
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0
# Optional public URL in production
# AUTH_URL=https://your-portal-host

# Microsoft Graph app-only credentials (server-side SharePoint access)
# Keep these server-only. Never prefix with NEXT_PUBLIC_.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-graph-app-client-id
AZURE_CLIENT_SECRET=your-graph-app-client-secret

# SharePoint site (Graph site ID)
# Site URL: https://pavetraining.sharepoint.com/sites/PaveTrainingOperationAdmin
# Graph accepts hostname:/sites/SiteName or the opaque site GUID
SHAREPOINT_SITE_ID=pavetraining.sharepoint.com:/sites/PaveTrainingOperationAdmin

# SharePoint list IDs (names/fields are defined in src/lib/schema/sharepointSchema.ts)
SHAREPOINT_COMPANY_LIST_ID=your-company-list-id
SHAREPOINT_WORKFORCE_LIST_ID=your-workforce-list-id
SHAREPOINT_TRAINING_MATRIX_LIST_ID=your-training-matrix-list-id
SHAREPOINT_NPORS_REGISTER_LIST_ID=your-npors-register-list-id
SHAREPOINT_EUSR_REGISTER_LIST_ID=your-eusr-register-list-id
SHAREPOINT_NRSWA_REGISTER_LIST_ID=your-nrswa-register-list-id
SHAREPOINT_IN_HOUSE_CERTIFICATES_LIST_ID=your-in-house-certificates-list-id
SHAREPOINT_NVQ_REGISTER_LIST_ID=your-nvq-register-list-id
SHAREPOINT_CUSTOMER_DOCUMENTS_LIST_ID=your-customer-documents-list-id
SHAREPOINT_EVENTS_LIST_ID=your-events-list-id
SHAREPOINT_OFFERS_PROMOTIONS_LIST_ID=your-offers-promotions-list-id
SHAREPOINT_PERMISSIONS_LIST_ID=your-permissions-list-id
SHAREPOINT_DEPARTMENTS_LIST_ID=your-departments-list-id
# SHAREPOINT_NPORS_CATEGORIES_LIST_ID=your-npors-categories-list-id
# SHAREPOINT_TRAINING_COURSE_CATEGORIES_LIST_ID=your-training-course-categories-list-id
# SHAREPOINT_TRAINING_MATRIX_CATEGORY_RECORDS_LIST_ID=your-training-matrix-category-records-list-id
# Active wide matrix list (DateTime columns) — SharePoint "Training Matrix Update"
SHAREPOINT_TRAINING_MATRIX_EXAMPLE_LIST_ID=your-training-matrix-update-list-id
SHAREPOINT_TRAINING_MANAGER_LOGS_LIST_ID=your-training-manager-logs-list-id

# Notifications (Graph sendMail — optional)
# App registration needs Mail.Send (application) and a send-as mailbox.
NOTIFICATIONS_ENABLED=true
EXPIRY_REMINDERS_ENABLED=true
# Optional: also remind for already-expired matrix rows
EXPIRED_REMINDERS_ENABLED=false
# End of 6-month reminder window (91–N days). Use 180 or 270.
EXPIRY_REMINDER_6M_MAX_DAYS=180
# Mailbox the app can send as (required for real email delivery).
# Use a real licensed / shared mailbox people already know (e.g. info@),
# not a made-up noreply address — unknown senders land in junk.
# NOTIFICATION_FROM_EMAIL=info@yourdomain.com
# Optional Reply-To if different from the From mailbox
# NOTIFICATION_REPLY_TO_EMAIL=info@yourdomain.com
# Optional comma-separated admin alert recipients
# NOTIFICATION_ADMIN_EMAILS=admin@yourdomain.com

# Optional Portal Settings list (Title: Portal Settings)
# Store JSON in Notes or SettingsJson on a single item titled "PAVE Portal Settings".
# If unset / missing, Admin Settings uses safe defaults and shows "Using default settings".
# SHAREPOINT_PORTAL_SETTINGS_LIST_ID=your-portal-settings-list-id

# Outlook Calendar sync (Phase 1: SharePoint Events → Outlook / mobile)
# Preferred: Microsoft 365 group calendar (Pave Training Operations).
#   App needs Group.ReadWrite.All or Calendars.ReadWrite + group calendar access, admin consent.
#   OUTLOOK_GROUP_ID=<group object id>
# Fallback: shared mailbox / user calendar.
#   App needs Calendars.ReadWrite (application) + admin consent.
#   OUTLOOK_USER_ID=calendar-owner@yourdomain.com
# Optional specific calendar (omit = default calendar):
#   OUTLOOK_CALENDAR_ID=
# OUTLOOK_GROUP_ID=
# OUTLOOK_USER_ID=
# OUTLOOK_CALENDAR_ID=