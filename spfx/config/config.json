{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "pave-admin-portal-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/paveAdminPortal/PaveAdminPortalWebPart.js",
          "manifest": "./src/webparts/paveAdminPortal/PaveAdminPortalWebPart.manifest.json"
        }
      ]
    },
    "pave-customer-portal-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/paveCustomerPortal/PaveCustomerPortalWebPart.js",
          "manifest": "./src/webparts/paveCustomerPortal/PaveCustomerPortalWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "PaveAdminPortalWebPartStrings": "lib/webparts/paveAdminPortal/loc/{locale}.js",
    "PaveCustomerPortalWebPartStrings": "lib/webparts/paveCustomerPortal/loc/{locale}.js"
  }
}
